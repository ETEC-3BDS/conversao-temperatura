@{
    ViewData["Title"] = "Celsius para Fahrenheit";
}

<div class="container mt-5">

    <h1>Celsius → Fahrenheit</h1>

    <form method="post">

        <div class="mb-3">

            <label class="form-label">
                Temperatura em Celsius
            </label>

            <input 
                type="number"
                step="0.01"
                name="celsius"
                class="form-control"
                placeholder="Digite a temperatura"
                required />

        </div>

        <button 
            type="submit" 
            class="btn btn-primary">

            Converter

        </button>

    </form>

    @if (ViewBag.Resultado != null)
    {
        <div class="alert alert-success mt-4">

            Resultado:

            <strong>
                @ViewBag.Resultado °F
            </strong>

        </div>
    }

</div>