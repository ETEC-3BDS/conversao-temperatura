@{
    ViewData["Title"] = "Kelvin para Celsius";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-header text-center">
                    <h2>Kelvin → Celsius</h2>
                </div>

                <div class="card-body">

                    <form method="post">

                        <div class="mb-3">
                            <label class="form-label">
                                Temperatura em Kelvin
                            </label>

                            <input 
                                type="number"
                                step="0.01"
                                name="kelvin"
                                class="form-control"
                                placeholder="Digite a temperatura"
                                required />
                        </div>

                        <button 
                            type="submit"
                            class="btn btn-primary w-100">

                            Converter

                        </button>

                    </form>

                    @if (ViewBag.Resultado != null)
                    {
                        <div class="alert alert-success mt-4 text-center">

                            <h4>Resultado</h4>

                            <strong>
                                @ViewBag.Resultado °C
                            </strong>

                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>